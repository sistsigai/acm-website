# Server Environment Example (Placeholders only - do not put secrets here)
# Copy this file to '.env.development' for local development or '.env.production' for production.
# Note: Root .env is not used.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=acm-website
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d
ALLOWED_ORIGINS=http://localhost:5173,https://sistsigai.acm.org

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Mail Credentials
MAIL_USER=your_smtp_mail_user@gmail.com
MAIL_PASS=your_smtp_mail_password
